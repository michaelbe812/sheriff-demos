{
  "version": 2,
  "outputCapture": "direct-nodejs",
  "$schema": "https://json-schema.org/schema",
  "title": "OpenAPI-Client (ClientDefinition, siehe docs/openapi-facade-spike.md)",
  "type": "object",
  "properties": {
    "name": { "type": "string", "description": "Client-Name = Ordnername, z.B. pet-client." },
    "placement": {
      "description": "'shared' → libs/generated/<name>, { domain } → libs/<domain>/generated/<name>.",
      "oneOf": [
        { "const": "shared" },
        { "type": "object", "properties": { "domain": { "type": "string" } }, "required": ["domain"], "additionalProperties": false }
      ]
    },
    "spec": {
      "type": "object",
      "properties": {
        "file": { "type": "string", "description": "Committete Spec, workspace-relativ. Einzige Quelle für generate." },
        "url": { "type": "string", "description": "Optional: Quelle für update-spec." }
      },
      "required": ["file"],
      "additionalProperties": false
    },
    "generator": {
      "type": "object",
      "properties": {
        "adapter": { "type": "string" },
        "options": { "type": "object" }
      },
      "required": ["adapter"],
      "additionalProperties": false
    }
  },
  "required": ["name", "placement", "spec", "generator"],
  "additionalProperties": false
}
