{
  "version": 2,
  "outputCapture": "direct-nodejs",
  "$schema": "https://json-schema.org/schema",
  "title": "ng-lib build",
  "type": "object",
  "properties": {
    "entryFile": { "type": "string", "description": "Entry relativ zum Workspace. Default {projectRoot}/src/index.ts." },
    "outputPath": { "type": "string", "description": "dist-Ordner relativ zum Workspace. Default dist/{projectRoot}." },
    "tsConfig": { "type": "string", "description": "Gemeinsame tsconfig relativ zum Workspace.", "default": "libs/tsconfig.lib.json" },
    "compilerOptions": { "type": "object", "description": "Overrides auf tsConfig (z.B. declarationMap:false für production).", "default": {} },
    "importPath": { "type": "string", "description": "Paketname. Default: Alias aus tsconfig.base.json paths." },
    "watch": { "type": "boolean", "default": false }
  },
  "additionalProperties": false
}
