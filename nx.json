{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "analytics": false,
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/.eslintrc.json",
      "!{projectRoot}/eslint.config.mjs",
      "!{projectRoot}/**/*.spec.ts",
      "!{projectRoot}/tsconfig.spec.json"
    ],
    "sharedGlobals": []
  },
  "targetDefaults": {
    "@nx/eslint:lint": {
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/.eslintrc.json",
        "{workspaceRoot}/.eslintignore",
        "{workspaceRoot}/eslint.config.mjs"
      ]
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["^generate"],
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/tsconfig.base.json",
        {
          "dependentTasksOutputFiles": "**/src/generated/**/*.ts",
          "transitive": true
        },
        {
          "externalDependencies": ["eslint"]
        }
      ],
      "options": {
        "command": "eslint .",
        "cwd": "{projectRoot}"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["^generate"],
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/tsconfig.base.json",
        {
          "dependentTasksOutputFiles": "**/src/generated/**/*.ts",
          "transitive": true
        },
        {
          "externalDependencies": ["typescript"]
        }
      ],
      "options": {
        "command": "tsc -p {projectRoot}/tsconfig.json"
      }
    },
    "build": {
      "executor": "@nx/angular:ng-packagr-lite",
      "cache": true,
      "dependsOn": ["^build", "^generate"],
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/tsconfig.base.json",
        {
          "dependentTasksOutputFiles": "**/src/generated/**/*.ts",
          "transitive": true
        },
        {
          "externalDependencies": ["ng-packagr", "@angular/compiler-cli", "typescript"]
        }
      ],
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "defaultConfiguration": "production",
      "options": {
        "project": "{projectRoot}/ng-package.json",
        "tsConfig": "{projectRoot}/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "{projectRoot}/tsconfig.lib.prod.json"
        },
        "development": {}
      }
    },
    "test": {
      "executor": "@blueprint/tooling-ng-lib:test",
      "cache": true,
      "dependsOn": ["^generate"],
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/tsconfig.base.json",
        "{workspaceRoot}/vitest-base.config.mts",
        "{workspaceRoot}/packages/tooling/ng-lib/src/**/*",
        {
          "dependentTasksOutputFiles": "**/src/generated/**/*.ts",
          "transitive": true
        },
        {
          "externalDependencies": [
            "vitest",
            "@vitest/browser-playwright",
            "msw",
            "openapi-msw",
            "@faker-js/faker",
            "@angular/build"
          ]
        }
      ],
      "options": {
        "tsConfig": "{projectRoot}/tsconfig.spec.json",
        "runnerConfig": "vitest-base.config.mts",
        "browsers": ["chromiumHeadless"],
        "watch": false
      }
    },
    "@nx/angular:application": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/tsconfig.base.json",
        {
          "dependentTasksOutputFiles": "**/src/generated/**/*.ts",
          "transitive": true
        }
      ]
    }
  },
  "generators": {
    "@nx/angular:application": {
      "e2eTestRunner": "none",
      "linter": "eslint",
      "style": "css",
      "unitTestRunner": "none"
    },
    "@nx/angular:component": {
      "style": "css"
    }
  },
  "sync": {
    "globalGenerators": ["@blueprint/tooling-workspace:app-routes"]
  }
}
