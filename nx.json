{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "analytics": false,
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "sharedGlobals"
    ],
    "production": [
      "default",
      "!{projectRoot}/.eslintrc.json",
      "!{projectRoot}/eslint.config.mjs",
      "!{projectRoot}/**/*.spec.ts"
    ],
    "sharedGlobals": []
  },
  "targetDefaults": {
    "@nx/eslint:lint": {
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/.eslintrc.json",
        "{workspaceRoot}/.eslintignore",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/tools/eslint-rules/**/*"
      ]
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "cache": true
    },
    "./tools/ng-lib:application": {
      "cache": true,
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/tsconfig.base.json",
        "{workspaceRoot}/tools/ng-lib/**/*"
      ]
    }
  },
  "generators": {
    "@nx/angular:application": {
      "e2eTestRunner": "none",
      "linter": "eslint",
      "style": "css",
      "unitTestRunner": "none"
    }
  },
  "plugins": [
    "./tools/nx-plugins/blueprint-libs.ts",
    {
      "plugin": "./tools/nx-plugins/blueprint-openapi-clients.ts",
      "options": {
        "defaultAdapter": "openapi-tools",
        "clients": {
          "generated/pet-client": {
            "url": "https://petstore3.swagger.io/api/v3/openapi.json",
            "adapter": "hey-api"
          }
        }
      }
    }
  ]
}
