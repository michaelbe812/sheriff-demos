{
  "name": "tooling-coupling",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/tooling/coupling/src",
  "tags": ["type:tooling", "tooling:coupling"],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": [],
      "inputs": [
        "default",
        "^default",
        {
          "externalDependencies": ["typescript"]
        }
      ],
      "options": {
        "command": "tsc -p packages/tooling/coupling/tsconfig.json"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "^default",
        {
          "externalDependencies": ["vitest", "typescript"]
        }
      ],
      "options": {
        "command": "vitest run --config packages/tooling/coupling/vitest.config.mts"
      }
    },
    "analyze": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node --experimental-strip-types --no-warnings=ExperimentalWarning packages/tooling/coupling/src/cli.ts --repo . --out dist/coupling"
      }
    }
  }
}
