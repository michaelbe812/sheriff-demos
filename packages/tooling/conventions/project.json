{
  "name": "tooling-conventions",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/tooling/conventions/src",
  "tags": ["type:tooling", "tooling:conventions"],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "^default",
        {
          "externalDependencies": ["typescript", "@nx/devkit"]
        }
      ],
      "options": {
        "command": "tsc -p packages/tooling/conventions/tsconfig.json"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "^default",
        {
          "externalDependencies": ["vitest", "@nx/devkit", "typescript"]
        }
      ],
      "options": {
        "command": "vitest run --config packages/tooling/conventions/vitest.config.mts"
      }
    }
  }
}
