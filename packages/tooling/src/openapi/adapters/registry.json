{
  "$comment": "Adapter registry: read by the facade (ESM) AND synchronously by the crystal plugin. `packages`, `inputs` and `runtime` become cache inputs of the generate target: adapter version = package version (+ jar version in openapitools.json, + JRE). A new adapter = one entry + one module.",
  "openapi-tools": {
    "module": "./openapi-tools.mjs",
    "packages": ["@openapitools/openapi-generator-cli"],
    "inputs": ["{workspaceRoot}/openapitools.json"],
    "runtime": ["java -version 2>&1"]
  },
  "hey-api": {
    "module": "./hey-api.mjs",
    "packages": ["@hey-api/openapi-ts"],
    "inputs": [],
    "runtime": []
  },
  "nx-plugin-openapi": {
    "module": "./nx-plugin-openapi.mjs",
    "packages": [
      "@nx-plugin-openapi/core",
      "@nx-plugin-openapi/plugin-openapi",
      "@nx-plugin-openapi/plugin-hey-api",
      "@openapitools/openapi-generator-cli",
      "@hey-api/openapi-ts"
    ],
    "inputs": ["{workspaceRoot}/openapitools.json"],
    "runtime": ["java -version 2>&1"]
  }
}
