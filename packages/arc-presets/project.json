{
  "name": "arc-presets",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/arc-presets/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/arc-presets",
        "main": "packages/arc-presets/src/index.ts",
        "tsConfig": "packages/arc-presets/tsconfig.lib.json",
        "assets": [
          {
            "input": "packages/arc-presets/src",
            "glob": "**/schema.json",
            "output": "src"
          },
          "packages/arc-presets/generators.json",
          "packages/arc-presets/README.md",
          {
            "input": "packages/arc-presets/presets",
            "glob": "**/*",
            "output": "presets"
          }
        ]
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run",
        "cwd": "packages/arc-presets"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
