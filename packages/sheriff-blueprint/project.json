{
  "name": "sheriff-blueprint",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/sheriff-blueprint/src",
  "tags": [
    "type:tooling"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run build",
        "cwd": "packages/sheriff-blueprint"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run",
        "cwd": "packages/sheriff-blueprint"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
