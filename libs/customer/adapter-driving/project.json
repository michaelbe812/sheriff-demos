{
  "name": "customer-adapter-driving",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/customer/adapter-driving/src",
  "prefix": "hex",
  "tags": [
    "scope:customer",
    "type:adapter-driving"
  ],
  "targets": {
    "build": {
      "executor": "@nx/angular:ng-packagr-lite",
      "outputs": [
        "{workspaceRoot}/dist/{projectRoot}"
      ],
      "defaultConfiguration": "production",
      "options": {
        "project": "libs/customer/adapter-driving/ng-package.json",
        "tsConfig": "libs/customer/adapter-driving/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/customer/adapter-driving/tsconfig.lib.prod.json"
        },
        "development": {}
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "typecheck": {}
  }
}
