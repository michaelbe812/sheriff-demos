{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": [
      "es2020",
      "dom"
    ],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": false,
    "paths": {
      "@blueprint/tooling-conventions": [
        "./packages/tooling/conventions/src/lib-conventions.ts"
      ],
      "@blueprint/tooling-conventions/tree": [
        "./packages/tooling/conventions/src/tree.ts"
      ],
      "@blueprint/tooling-conventions/testing": [
        "./packages/tooling/conventions/src/testing/blueprint-tree.ts"
      ],
      "@blueprint/tooling-openapi": [
        "./packages/tooling/openapi/src/plugin/openapi-clients.ts"
      ],
      "@blueprint/tooling-openapi/clients": [
        "./packages/tooling/openapi/src/clients.ts"
      ],
      "@blueprint/*": [
        "./libs/*/src/index.ts"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "tmp"
  ]
}
